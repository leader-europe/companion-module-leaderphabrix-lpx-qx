{
    "name": "leaderphabrix-lpx-qx",
    "version": "1.0.1",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "postinstall": "husky",
        "format": "prettier -w .",
        "package": "run build && companion-module-build",
        "build": "rimraf dist && run build:main",
        "build:main": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "lint:raw": "eslint",
        "lint": "run lint:raw ."
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/leader-europe/companion-module-leaderphabrix-lpx-qx"
    },
    "engines": {
        "node": "^22.23",
        "yarn": "^4"
    },
    "dependencies": {
        "@companion-module/base": "~1.14.1"
    },
    "devDependencies": {
        "@companion-module/tools": "^2.8.0",
        "@types/node": "^22.19.3",
        "eslint": "^9.39.2",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.9.8",
        "rimraf": "^6.1.2",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.51.0"
    },
    "prettier": "@companion-module/tools/.prettierrc.json",
    "lint-staged": {
        "*.{css,json,md,scss}": [
            "prettier --write"
        ],
        "*.{ts,tsx,js,jsx}": [
            "yarn lint:raw --fix"
        ]
    },
    "packageManager": "yarn@4.18.1"
}
